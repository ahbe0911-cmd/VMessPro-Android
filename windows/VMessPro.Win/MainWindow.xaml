<Window x:Class="VMessPro.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMess Pro 0.6.2 • Windows 8.1"
        Width="1040" Height="720" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirFont}"
        Background="#0A1020"
        Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A1020" Offset="0"/>
            <GradientStop Color="#0D172A" Offset="0.42"/>
            <GradientStop Color="#10162B" Offset="0.72"/>
            <GradientStop Color="#0C1020" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="Surface" Color="#D9151D31"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#B812192B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#334A5B7A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF7FBFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFA8B5CA"/>
        <SolidColorBrush x:Key="Purple" Color="#FF9A7CFF"/>
        <SolidColorBrush x:Key="Cyan" Color="#FF37D8FF"/>
        <SolidColorBrush x:Key="Emerald" Color="#FF45E0A7"/>
        <SolidColorBrush x:Key="Lime" Color="#FFC8F35A"/>
        <SolidColorBrush x:Key="Pink" Color="#FFFF78B7"/>
        <SolidColorBrush x:Key="Danger" Color="#FFFF5E70"/>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#C7162034"/>
            <Setter Property="BorderBrush" Value="#3D61708E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF202C46"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#667B8CAB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.90"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.68"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,7"/>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#F1121929"/>
            <Setter Property="BorderBrush" Value="#485A6C89"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowGradient}" FlowDirection="LeftToRight">
        <Canvas IsHitTestVisible="False" Opacity="0.42">
            <Ellipse Width="430" Height="430" Canvas.Left="-170" Canvas.Top="310">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4A37D8FF" Offset="0"/>
                        <GradientStop Color="#0037D8FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="420" Height="420" Canvas.Right="-130" Canvas.Top="-110">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#459A7CFF" Offset="0"/>
                        <GradientStop Color="#009A7CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- GLOBAL HEADER -->
            <Grid Grid.Row="0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#C8151D31" BorderBrush="#334A5B7A" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="White" FontWeight="Bold" FontSize="14" FlowDirection="LeftToRight"/>
                            <TextBlock x:Name="PersianDateText" Text="—" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Button Width="38" Height="38" Style="{StaticResource GlassButton}" Click="SettingsNav_Click" Content="⚙" FontFamily="Segoe UI Symbol" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Border Background="#2B9A7CFF" BorderBrush="#559A7CFF" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,9,0">
                        <TextBlock Text="PRO" Foreground="#FFDCCFFF" FontSize="10" FontWeight="Black"/>
                    </Border>
                    <StackPanel FlowDirection="RightToLeft">
                        <TextBlock Text="VMess Pro" Foreground="White" FontSize="23" FontWeight="Black" HorizontalAlignment="Right"/>
                        <TextBlock Text="Windows 8.1 • Xray + Wintun" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- HOME: DESKTOP LAYOUT, NO SCROLL -->
            <Grid x:Name="HomePage" Grid.Row="1" Margin="0,6,0,8" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT CONTENT -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92"/>
                        <RowDefinition Height="116"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SERVER CARD -->
                    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="#3E61708E" BorderThickness="1" CornerRadius="20" Padding="14" Cursor="Hand" MouseLeftButtonUp="ServerCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#FFF3F7FF" VerticalAlignment="Center">
                                <TextBlock Text="◎" Foreground="#FF6E62FF" FontFamily="Segoe UI Symbol" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="سرور انتخاب‌شده" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                <TextBlock x:Name="ServerNameText" Text="انتخاب سرور" Foreground="White" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ServerMetaText" Text="برای اتصال یک پروفایل انتخاب کنید" Foreground="{StaticResource Emerald}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#2437D8FF" BorderBrush="#3937D8FF" BorderThickness="1" CornerRadius="13" Padding="9" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Xray" Foreground="{StaticResource Cyan}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="مشاهده ›" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- COMPACT STATS -->
                    <Grid Grid.Row="1" Margin="0,10,0,0" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,5,0" Background="{StaticResource SurfaceSoft}" BorderBrush="#3F9A7CFF" BorderThickness="1" CornerRadius="17" Padding="11" FlowDirection="RightToLeft">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{StaticResource Purple}" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="IP" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                                <TextBlock x:Name="IpText" Text="—" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,7,0,1" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="IpSubText" Text="قطع" Foreground="{StaticResource Danger}" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="5,0" Background="{StaticResource SurfaceSoft}" BorderBrush="#3FC8F35A" BorderThickness="1" CornerRadius="17" Padding="11" FlowDirection="RightToLeft">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="ϟ" Foreground="{StaticResource Lime}" FontSize="17" Margin="0,0,6,0"/><TextBlock Text="Ping" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,7,0,1"><TextBlock x:Name="PingText" Text="—" Foreground="White" FontSize="21" FontWeight="Black"/><TextBlock Text=" ms" Foreground="{StaticResource Lime}" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3"/></StackPanel>
                                <TextBlock Text="تأخیر واقعی" Foreground="{StaticResource Lime}" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="5,0" Background="{StaticResource SurfaceSoft}" BorderBrush="#3F37D8FF" BorderThickness="1" CornerRadius="17" Padding="11" FlowDirection="RightToLeft">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="↓" Foreground="{StaticResource Cyan}" FontSize="17" Margin="0,0,6,0"/><TextBlock Text="Speed" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,7,0,1"><TextBlock x:Name="SpeedText" Text="0.0" Foreground="White" FontSize="21" FontWeight="Black"/><TextBlock Text=" Mbps" Foreground="{StaticResource Cyan}" FontSize="9" VerticalAlignment="Bottom" Margin="3,0,0,3"/></StackPanel>
                                <TextBlock Text="دانلود زنده" Foreground="{StaticResource Cyan}" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Margin="5,0,0,0" Background="{StaticResource SurfaceSoft}" BorderBrush="#3FFF78B7" BorderThickness="1" CornerRadius="17" Padding="11" FlowDirection="RightToLeft">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="◆" Foreground="{StaticResource Pink}" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Protocol" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                                <TextBlock x:Name="SecurityText" Text="Xray" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,7,0,1"/>
                                <TextBlock x:Name="SecuritySubText" Text="آماده" Foreground="{StaticResource Purple}" FontSize="9"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- NETWORK SUMMARY -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Background="#A9111828" BorderBrush="#314A5B7A" BorderThickness="1" CornerRadius="18" Padding="14" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="مسیر اتصال واقعی" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Windows → Wintun → tun2socks → Xray → Server" Foreground="{StaticResource TextSecondary}" FontSize="10" FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                <TextBlock Text="وضعیت Connected فقط بعد از عبور HTTPS واقعی نمایش داده می‌شود." Foreground="#FF7D8CA5" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2545E0A7" BorderBrush="#4045E0A7" BorderThickness="1" CornerRadius="14" Padding="10,7" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="REAL TUN" Foreground="{StaticResource Emerald}" FontWeight="Black" FontSize="10" FlowDirection="LeftToRight"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT CONNECT PANEL -->
                <Border Grid.Row="0" Grid.Column="1" Background="#E0131A2B" BorderBrush="#435A6B8A" BorderThickness="1" CornerRadius="24" Padding="20" FlowDirection="RightToLeft">
                    <Border.Effect><DropShadowEffect Color="#55000000" BlurRadius="20" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="اتصال امن" Foreground="White" FontSize="21" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="Xray • Wintun • اتصال واقعی" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="194" Height="194" HorizontalAlignment="Center">
                                <Border x:Name="PowerOuter" CornerRadius="97" BorderBrush="#FF9A7CFF" BorderThickness="2" Background="#10000000">
                                    <Border.Effect><DropShadowEffect x:Name="PowerGlow" Color="#FF9A7CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                                </Border>
                                <Border x:Name="PowerMid" Margin="8" CornerRadius="89" BorderBrush="#424F607B" BorderThickness="1" Background="#12000000"/>
                                <Border x:Name="PowerCore" Margin="17" CornerRadius="80" BorderBrush="#6B9A7CFF" BorderThickness="1">
                                    <Border.Background>
                                        <RadialGradientBrush>
                                            <GradientStop x:Name="PowerCenterStop" Color="#FF7768EE" Offset="0"/>
                                            <GradientStop x:Name="PowerEdgeStop" Color="#FF3A4FD0" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Button x:Name="PowerButton" Click="PowerButton_Click" Style="{StaticResource PowerButtonStyle}" Foreground="White">
                                        <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="PowerLabel" Text="اتصال" Foreground="White" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="StatusText" Text="قطع • آماده برای اتصال" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#A7111827" BorderBrush="#294A5B7A" BorderThickness="1" CornerRadius="15" Padding="10">
                            <TextBlock Text="برای اتصال روی دکمه بالا بزنید. در صورت خطا، پیام دقیق در همین صفحه نمایش داده می‌شود." Foreground="{StaticResource TextSecondary}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- QUICK ACTIONS -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="0,0,5,0" Height="58" Style="{StaticResource GlassButton}" Click="AddButton_Click">
                        <StackPanel FlowDirection="RightToLeft"><TextBlock Text="+" Foreground="{StaticResource Cyan}" FontSize="19" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="افزودن" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="5,0" Height="58" Style="{StaticResource GlassButton}" Click="TestAllButton_Click">
                        <StackPanel FlowDirection="RightToLeft"><TextBlock Text="ϟ" Foreground="{StaticResource Lime}" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="تست همه" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Margin="5,0" Height="58" Style="{StaticResource GlassButton}" Click="SplitButton_Click">
                        <StackPanel FlowDirection="RightToLeft"><TextBlock Text="↗" Foreground="{StaticResource Pink}" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Split" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Grid.Column="3" Margin="5,0" Height="58" Style="{StaticResource GlassButton}" Click="ServersNav_Click">
                        <StackPanel FlowDirection="RightToLeft"><TextBlock Text="⬡" Foreground="{StaticResource Purple}" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Xray" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Grid.Column="4" Margin="5,0,0,0" Height="58" Style="{StaticResource GlassButton}" Click="SmartButton_Click">
                        <StackPanel FlowDirection="RightToLeft"><TextBlock Text="◆" Foreground="{StaticResource Emerald}" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="هوشمند" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- SERVERS -->
            <Grid x:Name="ServersPage" Grid.Row="1" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Center" Margin="0,8,0,8" FlowDirection="RightToLeft">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="سرورها" Foreground="White" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="کانفیگ‌ها، تست واقعی و انتخاب سریع‌ترین مسیر" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource GlassButton}" Click="AddButton_Click" Content="+ افزودن کانفیگ / Subscription"/>
                    <Button Grid.Column="1" Margin="5,0" Style="{StaticResource GlassButton}" Click="TestAllButton_Click" Content="تست واقعی همه"/>
                    <Button Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource GlassButton}" Click="SmartButton_Click" Content="انتخاب سریع‌ترین"/>
                </Grid>
                <ListBox x:Name="ProfilesList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ProfilesList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#C9151D31" BorderBrush="#344A5B7A" BorderThickness="1" CornerRadius="14" Margin="0,4" Padding="12">
                                <Grid Width="820">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Host}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Protocol}" Foreground="{StaticResource Emerald}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding LatencyMs, StringFormat={}{0} ms}" Foreground="{StaticResource Lime}" FontSize="10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- STATS -->
            <Grid x:Name="StatsPage" Grid.Row="1" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Center" Margin="0,8,0,8" FlowDirection="RightToLeft">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="آمار اتصال" Foreground="White" FontSize="24" FontWeight="Black"/><TextBlock Text="اطلاعات زنده از رابط VMessPro Wintun" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                <Grid Grid.Row="1" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,6,0" Background="{StaticResource Surface}" BorderBrush="#3F37D8FF" BorderThickness="1" CornerRadius="18" Padding="18" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="دانلود لحظه‌ای" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="StatsDownloadText" Text="0.0 Mbps" Foreground="White" FontSize="27" FontWeight="Black" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Text="↓" Foreground="{StaticResource Cyan}" FontSize="24"/></StackPanel></Border>
                    <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource Surface}" BorderBrush="#3F45E0A7" BorderThickness="1" CornerRadius="18" Padding="18" FlowDirection="RightToLeft"><StackPanel><TextBlock Text="آپلود لحظه‌ای" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="StatsUploadText" Text="0.0 Mbps" Foreground="White" FontSize="27" FontWeight="Black" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Text="↑" Foreground="{StaticResource Emerald}" FontSize="24"/></StackPanel></Border>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource SurfaceSoft}" BorderBrush="#334A5B7A" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,12,0,0">
                    <StackPanel><TextBlock x:Name="StatsStateText" Text="وضعیت: قطع" Foreground="White" FontSize="14"/><TextBlock x:Name="StatsServerText" Text="سرور: —" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0"/><TextBlock x:Name="StatsIpText" Text="IP: —" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/></StackPanel>
                </Border>
            </Grid>

            <!-- SETTINGS -->
            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Center" Margin="0,8,0,8" FlowDirection="RightToLeft">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="تنظیمات" Foreground="White" FontSize="24" FontWeight="Black"/><TextBlock Text="Windows 8.1 • VMess Pro 0.6.2" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="#344A5B7A" BorderThickness="1" CornerRadius="18" Padding="18">
                    <StackPanel>
                        <TextBlock Text="هسته اتصال" Foreground="White" FontSize="16" FontWeight="Black"/>
                        <TextBlock Text="Xray-core + tun2socks + Wintun" Foreground="{StaticResource Emerald}" Margin="0,5,0,0"/>
                        <Separator Background="#284A5B7A" Margin="0,11"/>
                        <TextBlock Text="اعتبار اتصال" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Connected فقط بعد از عبور HTTPS واقعی از Route سیستم نمایش داده می‌شود." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <Separator Background="#284A5B7A" Margin="0,11"/>
                        <TextBlock Text="فایل تشخیص" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="%LOCALAPPDATA%\VMessPro\run\windows-tunnel.log" Foreground="{StaticResource Cyan}" Margin="0,5,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="#B812192B" BorderBrush="#344A5B7A" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,12,0,0">
                    <TextBlock Text="Split Tunnel برنامه‌به‌برنامه در Windows 8.1 هنوز نمایشی نشده است؛ تونل فعلی Full-system و واقعی است." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- BOTTOM NAV -->
            <Border Grid.Row="2" Background="#EB101729" BorderBrush="#334A5B7A" BorderThickness="1" CornerRadius="22" Padding="6" MaxWidth="650" HorizontalAlignment="Center">
                <Grid Width="620" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeNav_Click" Background="#3B9A7CFF" BorderBrush="#559A7CFF"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="⌂" Foreground="White" FontFamily="Segoe UI Symbol" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="خانه" Foreground="White" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="1" x:Name="ServersNav" Style="{StaticResource NavButton}" Click="ServersNav_Click"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="●" Foreground="{StaticResource Cyan}" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="سرورها" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="2" x:Name="StatsNav" Style="{StaticResource NavButton}" Click="StatsNav_Click"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="▥" Foreground="{StaticResource Emerald}" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="آمار" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="3" x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel FlowDirection="RightToLeft"><TextBlock Text="⚙" Foreground="{StaticResource Pink}" FontFamily="Segoe UI Symbol" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="تنظیمات" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Border>
        </Grid>

        <!-- IMPORT OVERLAY -->
        <Grid x:Name="ImportOverlay" Visibility="Collapsed" Background="#C4080C18" FlowDirection="RightToLeft">
            <Border Width="660" MaxHeight="500" Background="#FF11192A" BorderBrush="#559A7CFF" BorderThickness="1" CornerRadius="22" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="افزودن کانفیگ یا Subscription" Foreground="White" FontSize="20" FontWeight="Black"/><TextBlock Text="VMess / VLESS / Reality / Trojan / لینک اشتراک" Foreground="{StaticResource TextSecondary}" FontSize="10"/></StackPanel>
                    <TextBox x:Name="ImportTextBox" Grid.Row="1" Style="{StaticResource FlatTextBox}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="240" FlowDirection="LeftToRight"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource GlassButton}" Click="ImportConfirm_Click" Content="ذخیره و بررسی"/><Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource GlassButton}" Click="ImportCancel_Click" Content="انصراف"/></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
