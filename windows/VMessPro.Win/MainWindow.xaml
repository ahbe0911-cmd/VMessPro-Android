<Window x:Class="VMessPro.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMess Pro • Windows 8.1"
        Width="960" Height="790" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirFont}"
        Background="#041A62"
        Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#041653" Offset="0"/>
            <GradientStop Color="#043795" Offset="0.42"/>
            <GradientStop Color="#0758C9" Offset="0.72"/>
            <GradientStop Color="#043485" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3CFFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2600134D"/>
            <Setter Property="BorderBrush" Value="#70FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowGradient}">
        <Canvas IsHitTestVisible="False" Opacity="0.55">
            <Ellipse Width="520" Height="520" Canvas.Left="-210" Canvas.Top="190">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5510E3FF" Offset="0"/><GradientStop Color="#0010E3FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="480" Height="480" Canvas.Right="-180" Canvas.Top="90">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#400879EE" Offset="0"/><GradientStop Color="#000879EE" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <!-- HOME -->
            <ScrollViewer x:Name="HomePage" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="800" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PersianDateText" Grid.Column="1" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,5">
                            <TextBlock x:Name="ClockText" Foreground="White" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,3,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="2" Width="68" Height="68" CornerRadius="18" Background="#780879EE" BorderBrush="#9010E3FF" BorderThickness="1" HorizontalAlignment="Right">
                            <TextBlock Text="◇" Foreground="White" FontSize="38" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="اتصال امن" Foreground="White" FontSize="32" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="سریع، واقعی و بدون اتصال نمایشی" Foreground="#C7DDFF" FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="0" Width="68" Height="68" CornerRadius="18" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBlock Text="♛" Foreground="#FFD542" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Grid Width="266" Height="266">
                            <Border x:Name="PowerOuter" CornerRadius="133" BorderBrush="#10E3FF" BorderThickness="3" Background="#08000000">
                                <Border.Effect><DropShadowEffect x:Name="PowerGlow" Color="#10E3FF" BlurRadius="35" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
                            </Border>
                            <Border x:Name="PowerMid" Margin="9" CornerRadius="124" BorderBrush="#EEFFFFFF" BorderThickness="2"/>
                            <Border x:Name="PowerCore" Margin="19" CornerRadius="114" BorderBrush="#5510E3FF" BorderThickness="2">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="PowerCenterStop" Color="#3EE8A5" Offset="0"/>
                                        <GradientStop x:Name="PowerEdgeStop" Color="#0879EE" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Button x:Name="PowerButton" Click="PowerButton_Click" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="88" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PowerLabel" Text="اتصال" Foreground="White" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,-7,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#FF4F65" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="قطع • آماده برای اتصال" Foreground="#FF4F65" FontSize="18" FontWeight="Black"/>
                    </StackPanel>

                    <Border Grid.Row="4" Background="#2AFFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="22" Padding="16,12" Margin="0,0,0,10" MouseLeftButtonUp="ServerCard_MouseLeftButtonUp" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#F5FFFFFF" HorizontalAlignment="Left">
                                <TextBlock Text="◎" Foreground="#0879EE" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="موقعیت فعلی" Foreground="#C7DDFF" FontSize="12"/>
                                <TextBlock x:Name="ServerNameText" Text="انتخاب سرور" Foreground="White" FontSize="20" FontWeight="Black" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ServerMetaText" Text="برای اتصال یک پروفایل انتخاب کنید" Foreground="#49F0AE" FontSize="12"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="42" Height="42" CornerRadius="21" Background="#35FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="‹" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="5" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,5,0" Background="#26FFFFFF" BorderBrush="#5FFFFFFF" BorderThickness="1" CornerRadius="18" Padding="10">
                            <StackPanel><TextBlock Text="آی‌پی" Foreground="#D9E9FF"/><TextBlock x:Name="IpText" Text="—" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,5"/><TextBlock x:Name="IpSubText" Text="قطع" Foreground="#FF4F65"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="5,0" Background="#26FFFFFF" BorderBrush="#5FFFFFFF" BorderThickness="1" CornerRadius="18" Padding="10">
                            <StackPanel><TextBlock Text="پینگ" Foreground="#D9E9FF"/><TextBlock x:Name="PingText" Text="—" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,5"/><TextBlock Text="ms" Foreground="#49F0AE"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="5,0" Background="#26FFFFFF" BorderBrush="#5FFFFFFF" BorderThickness="1" CornerRadius="18" Padding="10">
                            <StackPanel><TextBlock Text="سرعت" Foreground="#D9E9FF"/><TextBlock x:Name="SpeedText" Text="0.0" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,5"/><TextBlock Text="Mbps" Foreground="#10E3FF"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Margin="5,0,0,0" Background="#26FFFFFF" BorderBrush="#5FFFFFFF" BorderThickness="1" CornerRadius="18" Padding="10">
                            <StackPanel><TextBlock Text="امنیت" Foreground="#D9E9FF"/><TextBlock x:Name="SecurityText" Text="Xray" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,5"/><TextBlock x:Name="SecuritySubText" Text="آماده" Foreground="#C77BFF"/></StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource GlassButton}" Click="AddButton_Click"><StackPanel><TextBlock Text="+" Foreground="#10E3FF" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="افزودن"/></StackPanel></Button>
                        <Button Grid.Column="1" Margin="4,0" Style="{StaticResource GlassButton}" Click="TestAllButton_Click"><StackPanel><TextBlock Text="◉" Foreground="#10E3FF" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="تست همه"/></StackPanel></Button>
                        <Button Grid.Column="2" Margin="4,0" Style="{StaticResource GlassButton}" Click="SplitButton_Click"><StackPanel><TextBlock Text="↗" Foreground="#10E3FF" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Split"/></StackPanel></Button>
                        <Button Grid.Column="3" Margin="4,0" Style="{StaticResource GlassButton}" Click="ServersNav_Click"><StackPanel><TextBlock Text="⬡" Foreground="#10E3FF" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Xray"/></StackPanel></Button>
                        <Button Grid.Column="4" Margin="4,0,0,0" Style="{StaticResource GlassButton}" Click="SmartButton_Click"><StackPanel><TextBlock Text="↔" Foreground="#10E3FF" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="هوشمند"/></StackPanel></Button>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- SERVERS -->
            <Grid x:Name="ServersPage" Grid.Row="0" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,6,0,12">
                    <TextBlock Text="مکان‌ها و سرورها" Foreground="White" FontSize="30" FontWeight="Black"/>
                    <TextBlock Text="تست واقعی Xray و انتخاب بهترین کانفیگ" Foreground="#C7DDFF"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource GlassButton}" Click="AddButton_Click" Content="+ افزودن کانفیگ / Subscription"/>
                    <Button Grid.Column="1" Margin="5,0" Style="{StaticResource GlassButton}" Click="TestAllButton_Click" Content="تست واقعی همه"/>
                    <Button Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource GlassButton}" Click="SmartButton_Click" Content="انتخاب سریع‌ترین"/>
                </Grid>
                <ListBox x:Name="ProfilesList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ProfilesList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#25FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="16" Margin="0,4" Padding="12">
                                <Grid Width="730">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Host}" Foreground="#C7DDFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Protocol}" Foreground="#49F0AE" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding LatencyMs, StringFormat={}{0} ms}" Foreground="#10E3FF" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- STATS -->
            <Grid x:Name="StatsPage" Grid.Row="0" Visibility="Collapsed" MaxWidth="800" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,6,0,18"><TextBlock Text="آمار اتصال" Foreground="White" FontSize="30" FontWeight="Black"/><TextBlock Text="اعداد زنده از رابط Wintun" Foreground="#C7DDFF"/></StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,6,0" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"><StackPanel><TextBlock Text="دانلود لحظه‌ای" Foreground="#C7DDFF"/><TextBlock x:Name="StatsDownloadText" Text="0.0 Mbps" Foreground="White" FontSize="30" FontWeight="Black"/><TextBlock Text="↓" Foreground="#10E3FF" FontSize="28"/></StackPanel></Border>
                    <Border Grid.Column="1" Margin="6,0,0,0" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20"><StackPanel><TextBlock Text="آپلود لحظه‌ای" Foreground="#C7DDFF"/><TextBlock x:Name="StatsUploadText" Text="0.0 Mbps" Foreground="White" FontSize="30" FontWeight="Black"/><TextBlock Text="↑" Foreground="#49F0AE" FontSize="28"/></StackPanel></Border>
                </Grid>
                <Border Grid.Row="2" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="18" Margin="0,14,0,0">
                    <StackPanel><TextBlock x:Name="StatsStateText" Text="وضعیت: قطع" Foreground="White" FontSize="16"/><TextBlock x:Name="StatsServerText" Text="سرور: —" Foreground="#C7DDFF" Margin="0,8,0,0"/><TextBlock x:Name="StatsIpText" Text="IP: —" Foreground="#C7DDFF" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </Grid>

            <!-- SETTINGS -->
            <Grid x:Name="SettingsPage" Grid.Row="0" Visibility="Collapsed" MaxWidth="800" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,6,0,18"><TextBlock Text="تنظیمات" Foreground="White" FontSize="30" FontWeight="Black"/><TextBlock Text="Windows 8.1 • Xray + Wintun + tun2socks" Foreground="#C7DDFF"/></StackPanel>
                <Border Grid.Row="1" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="18">
                    <StackPanel>
                        <TextBlock Text="هسته اتصال" Foreground="White" FontSize="18" FontWeight="Black"/>
                        <TextBlock Text="Xray-core • کانفیگ‌ساز amnezia-libxray" Foreground="#49F0AE" Margin="0,6,0,0"/>
                        <Separator Background="#30FFFFFF" Margin="0,12"/>
                        <TextBlock Text="اعتبار اتصال" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Connected فقط بعد از HTTPS واقعی در مسیر TUN نمایش داده می‌شود." Foreground="#C7DDFF" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <Separator Background="#30FFFFFF" Margin="0,12"/>
                        <TextBlock Text="DNS تونل" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="1.1.1.1 روی رابط Wintun" Foreground="#C7DDFF" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="#20FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="20" Padding="16" Margin="0,14,0,0">
                    <TextBlock Text="Split Tunnel برنامه‌به‌برنامه در Windows 8.1 به WFP نیاز دارد و در این Build عمداً نمایشی نشده است؛ تونل فعلی Full-system و واقعی است." Foreground="#D9E9FF" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- BOTTOM NAV -->
            <Border Grid.Row="1" Background="#D9152765" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="28" Padding="8" Margin="0,10,0,0" MaxWidth="800" HorizontalAlignment="Center">
                <Grid Width="760">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeNav_Click"><StackPanel><TextBlock Text="⌂" Foreground="White" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="خانه" Foreground="White" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="1" x:Name="ServersNav" Style="{StaticResource NavButton}" Click="ServersNav_Click"><StackPanel><TextBlock Text="●" Foreground="#C7DDFF" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="مکان‌ها" Foreground="#C7DDFF" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="2" x:Name="StatsNav" Style="{StaticResource NavButton}" Click="StatsNav_Click"><StackPanel><TextBlock Text="▥" Foreground="#C7DDFF" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="آمار" Foreground="#C7DDFF" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="3" x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel><TextBlock Text="⚙" Foreground="#C7DDFF" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="تنظیمات" Foreground="#C7DDFF" HorizontalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Border>
        </Grid>

        <!-- IMPORT OVERLAY -->
        <Grid x:Name="ImportOverlay" Visibility="Collapsed" Background="#B0000A30">
            <Border Width="650" MaxHeight="520" Background="#FF082466" BorderBrush="#8010E3FF" BorderThickness="1" CornerRadius="24" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="افزودن کانفیگ یا Subscription" Foreground="White" FontSize="24" FontWeight="Black"/><TextBlock Text="VMess / VLESS / Reality / Trojan / لینک اشتراک" Foreground="#C7DDFF"/></StackPanel>
                    <TextBox x:Name="ImportTextBox" Grid.Row="1" Style="{StaticResource FlatTextBox}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="250" FlowDirection="LeftToRight"/>
                    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource GlassButton}" Click="ImportConfirm_Click" Content="ذخیره و بررسی"/><Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource GlassButton}" Click="ImportCancel_Click" Content="انصراف"/></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
